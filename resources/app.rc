#pragma code_page(65001)
#include <winver.h>
#include "../src/Version.h"
#ifndef STOUTWALL_DLL_VERSION
1 ICON "app.ico"
#endif
VS_VERSION_INFO VERSIONINFO
 FILEVERSION STOUTWALL_VERSION_NUMBER
 PRODUCTVERSION STOUTWALL_VERSION_NUMBER
 FILEFLAGSMASK 0x3fL
 FILEFLAGS VS_FF_PRERELEASE
 FILEOS VOS_NT_WINDOWS32
#ifdef STOUTWALL_DLL_VERSION
 FILETYPE VFT_DLL
#else
 FILETYPE VFT_APP
#endif
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080404B0"
    BEGIN
      VALUE "FileDescription", "胖哥每日壁纸"
      VALUE "FileVersion", STOUTWALL_VERSION_STRING
      VALUE "ProductName", "胖哥每日壁纸"
      VALUE "ProductVersion", STOUTWALL_VERSION_STRING
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x804, 1200
  END
END
